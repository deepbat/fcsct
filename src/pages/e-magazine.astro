---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { MAGAZINE_BY_YEAR, MAGAZINE_ISSUES } from '../data/site';

const total = MAGAZINE_ISSUES.length;
const latestYear = MAGAZINE_BY_YEAR[0]!.year;
---

<Base
  title="e-Magazine"
  description="Browse past issues of Ideas Exchange, the e-magazine of the F. C. Sondhi Charitable Trust — quarterly issues from 2020 through 2026."
>
  <PageHead
    eyebrow="Ideas Exchange"
    title="e-Magazine archive"
    lede="Every quarterly issue of Ideas Exchange published since 2020, in one place."
  />

  <section class="section section--tight">
    <div class="wrap">
      <ul class="grid grid--4 snapshot">
        <li class="stat">
          <span class="stat__value">{total}</span>
          <span class="stat__label">Issues in the archive</span>
        </li>
        <li class="stat">
          <span class="stat__value">{MAGAZINE_BY_YEAR.length}</span>
          <span class="stat__label">Years covered, 2020 – {latestYear}</span>
        </li>
        <li class="stat">
          <span class="stat__value">{Math.round(total / MAGAZINE_BY_YEAR.length)}</span>
          <span class="stat__label">Issues per year, published quarterly</span>
        </li>
        <li class="stat">
          <span class="stat__value">1,000</span>
          <span class="stat__label">Members on the circulation list</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Archive</p>
        <h2>Issues by year</h2>
        <p>
          Every issue below opens the published PDF. Back issues before 2020 are dispatched to
          subscribers by post — to request one, please <a href={url('/contact/')}>contact the
          Trust</a>.
        </p>
      </div>

      <div class="years">
        {
          MAGAZINE_BY_YEAR.map((y) => (
            <section class="year">
              <h3 class="year__title">{y.year}</h3>
              <ul class="year__list">
                {y.issues.map((issue) => (
                  <li class="issue">
                    <a
                      class="issue__name"
                      href={issue.href}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      {issue.name}
                      <span class="visually-hidden"> (opens PDF in a new tab)</span>
                    </a>
                    <a
                      class="issue__ask"
                      href={issue.href}
                      rel="noopener noreferrer"
                      target="_blank"
                      aria-label={`Read ${issue.name} (opens PDF in a new tab)`}
                    >
                      Read
                      <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M7 17 17 7M9 7h8v8" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <div class="cta mt-7">
        <div>
          <h3>Subscribe to Ideas Exchange</h3>
          <p>From ₹500 for two years within India. See the full subscription table.</p>
        </div>
        <div class="cta__actions">
          <a class="btn btn--accent" href={url('/ideas-exchange/')}>View subscription rates</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .snapshot {
    list-style: none;
    padding: 0;
    margin: 0;
    row-gap: var(--sp-5);
  }

  .years {
    display: grid;
    gap: var(--sp-5);
  }

  @media (min-width: 900px) {
    .years {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-5) var(--sp-6);
    }
  }

  .year {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .year__title {
    padding: var(--sp-4) var(--sp-5);
    font-size: 1.25rem;
    background: var(--green-50);
    border-bottom: 1px solid var(--line);
  }

  .year__list {
    list-style: none;
    padding: var(--sp-2) 0;
    margin: 0;
  }

  .issue {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: 0.7rem var(--sp-5);
    border-bottom: 1px solid var(--line-soft);
    transition: background-color 0.15s ease;
  }

  .issue:last-child {
    border-bottom: 0;
  }

  .issue:hover {
    background: var(--green-50);
  }

  .issue__name {
    font-size: 0.9375rem;
    color: var(--ink-800);
    text-decoration: none;
  }

  a.issue__name:hover {
    color: var(--green-700);
    text-decoration: underline;
  }

  .issue__ask {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--green-600);
    text-decoration: none;
  }

  .issue__ask:hover {
    color: var(--green-800);
    text-decoration: underline;
  }

  /* CTA */
  .cta {
    display: grid;
    gap: var(--sp-5);
    padding: var(--sp-6);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 140% at 85% 10%, var(--green-700) 0%, var(--green-900) 60%, #071d17 100%);
    color: var(--text-invert);
  }

  @media (min-width: 820px) {
    .cta {
      grid-template-columns: 1.4fr auto;
      align-items: center;
      gap: var(--sp-7);
    }
  }

  .cta h3 {
    color: #fff;
  }

  .cta p {
    margin-top: var(--sp-3);
    color: rgb(255 255 255 / 0.76);
  }
</style>
