---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { MAGAZINE_BY_YEAR, MAGAZINE_ISSUES } from '../data/site';

const total = MAGAZINE_ISSUES.length;
const latestYear = MAGAZINE_BY_YEAR[0]!.year;
---

<Base
  title="e-Magazine"
  description="Browse past issues of Ideas Exchange, the e-magazine of the F. C. Sondhi Charitable Trust — quarterly issues from 2020 through 2026."
>
  <PageHead
    eyebrow="e-magazine archive"
    title="Every issue, one place"
    lede="Every quarterly issue of Ideas Exchange published since 2020, opening as a PDF on Google Drive. Latest first."
  />

  <!-- ============ SNAPSHOT ============ -->
  <section class="section-tight">
    <div class="wrap">
      <div class="stats rv" style="border:var(--bd);border-radius:12px;box-shadow:var(--sh);padding:0">
        <div class="row" style="padding:38px 14px">
          <div><b>{total}</b><span>Issues in the archive</span></div>
          <div><b>{MAGAZINE_BY_YEAR.length}</b><span>Years covered, 2020 – {latestYear}</span></div>
          <div><b>4</b><span>Issues a year, published quarterly</span></div>
          <div><b>1,000</b><span>Members on the circulation list</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ARCHIVE ============ -->
  <section class="section-tight">
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">Archive</span> · newest first</p>
      <h2 class="h-sec rv">Issues <span class="hl">by year.</span></h2>
      <div class="w-grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr))">
        {
          MAGAZINE_BY_YEAR.map((y) => (
            <div class="year-card card rv">
              <h3>{y.year}</h3>
              <ul class="mags" style="margin-top:0.6rem">
                {y.issues.map((issue, i) => (
                  <li class={i === 0 && y.year === latestYear ? 'new' : undefined}>
                    <a href={issue.href} rel="noopener noreferrer" target="_blank">
                      {issue.name}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="note rv" style="margin-top:1.2rem">
        Back issues before 2020 are dispatched to subscribers by post — to request one, please
        <a href={url('/contact/')} style="font-weight:700;color:var(--navy)">contact the Trust</a>.
      </p>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="band">
    <div class="wrap">
      <p class="eyebrow rv"><span class="n" style="color:var(--lime)">Stay on the list</span></p>
      <h2 class="h-sec rv">Subscribe to <span class="hl">Ideas Exchange.</span></h2>
      <p class="rv" style="color:#b9cad6;max-width:50ch;margin-top:1.1rem">
        From Rs. 500 for two years within India, or Rs. 1,000 a year outside India.
      </p>
      <div class="hero-cta rv" style="margin-top:1.6rem">
        <a class="cta" href={url('/ideas-exchange/')}>View subscription rates<svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        <a class="cta cta--ghost" href={url('/contact/')}>Get in touch</a>
      </div>
    </div>
  </section>
</Base>
