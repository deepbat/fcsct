---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import { NAV } from '../data/site';
---

<Base title="Page not found" description="The page you were looking for could not be found.">
  <section class="section">
    <div class="wrap wrap-narrow text-center">
      <p class="code">404</p>
      <h1 class="mt-4">We couldn’t find that page</h1>
      <p class="lede mt-4">
        The link may be out of date. Try one of the pages below, or head back to the homepage.
      </p>

      <div class="links mt-6">
        <a class="btn btn--primary" href={url('/')}>Back to home</a>
        <a class="btn btn--ghost" href={url('/contact/')}>Contact the Trust</a>
      </div>

      <nav class="quick mt-7" aria-label="Site pages">
        <ul>
          {
            NAV.map((item) => (
              <li>
                <a href={url(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 8vw, 7rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--gold-500);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
  }

  .quick {
    padding-top: var(--sp-6);
    border-top: 1px solid var(--line);
  }

  .quick ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    justify-content: center;
  }

  .quick a {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border-radius: var(--r-full);
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.875rem;
    color: var(--ink-700);
    text-decoration: none;
  }

  .quick a:hover {
    border-color: var(--green-600);
    color: var(--green-800);
  }
</style>
