---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import { NAV } from '../data/site';
---

<Base title="Page not found" description="The page you were looking for could not be found.">
  <section>
    <div class="wrap center" style="padding-top:clamp(3rem,8vw,6rem)">
      <p class="mono rv" style="color:var(--muted)"><span class="n" style="color:var(--navy);font-weight:500">Error</span> · page not found</p>
      <h1 class="h-giant rv">Page <span class="hl">404.</span></h1>
      <p class="lede rv" style="margin:1.1rem auto 0">
        The link may be out of date. Try one of the pages below, or head back to the homepage.
      </p>

      <div class="hero-cta rv" style="justify-content:center;margin-top:1.6rem">
        <a class="cta" href={url('/')}>Back to home<svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        <a class="cta cta--ghost" href={url('/contact/')}>Contact the Trust</a>
      </div>

      <nav class="mt-7 rv" aria-label="Site pages">
        <ul class="mags" style="max-width:640px;margin-inline:auto">
          {
            NAV.map((item) => (
              <li>
                <a href={url(item.href)}>
                  {item.label}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>
