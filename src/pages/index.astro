---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import { SITE, UPDATES_NEWEST_FIRST } from '../data/site';

const latest = UPDATES_NEWEST_FIRST[0]!;
---

<Base title={SITE.name} description={SITE.description}>
  <!-- ============ HERO ============ -->
  <header class="hero" id="top">
    <div class="h-sky" aria-hidden="true">
      <div class="h-stars"></div>
      <div class="h-cl h-c1"><i style="left:6%;top:12%;width:17vw;height:10svh"></i><i style="left:52%;top:22%;width:23vw;height:12svh"></i></div>
      <div class="h-cl h-c2"><i style="left:20%;top:34%;width:27vw;height:14svh"></i><i style="left:70%;top:44%;width:19vw;height:10svh"></i></div>
    </div>
    <div class="h-grid" aria-hidden="true"></div>
    <div class="h-top">
      <span><i class="dot"></i>Serving Jalandhar since <b>2 May 1978</b></span>
      <span>15 Adarsh Nagar &middot; <b>Jalandhar, Punjab</b></span>
    </div>
    <div class="h-lock">
      <h1 class="rv">
        <span class="h-line">Helping the needy</span>
        <span class="h-photo"><img src={url('/images/ph-founder.webp')} width="400" height="390" decoding="async" alt="Mr. F. C. Sondhi, founder of the Trust" /></span>
        <span class="h-line"><span class="hl">learn, live &amp; hope.</span></span>
      </h1>
      <p class="h-lead rv">Every paisa donated <b>reaches the beneficiary.</b></p>
    </div>
    <div class="wrap hero-grid">
      <div>
        <p class="lede rv">
          F. C. Sondhi Charitable Trust sanctions scholarships and grants for students and for
          elderly and widowed people of Jalandhar and beyond. Every paisa donated goes to the
          beneficiary — the Trust bears all administration costs.
        </p>
        <div class="hero-cta rv">
          <a class="cta cta--lg" href={url('/how-to-donate/')}>Donate or sponsor a student
            <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a class="cta cta--lg cta--ghost" href={url('/about-us/')}>Our story</a>
        </div>
        <ul class="checks rv">
          <li><svg viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5" /></svg>Since 1978</li>
          <li><svg viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5" /></svg>80G tax exempt</li>
          <li><svg viewBox="0 0 24 24"><path d="M4 12.5l5 5L20 6.5" /></svg>Home-verified applications</li>
        </ul>
      </div>

      <aside class="panel rv" role="status" aria-label="The Trust at a glance">
        <div class="panel-head"><b><svg width="13" height="13" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" /></svg>The Trust / At a glance</b><span class="stat">FY 2025–26</span></div>
        <div class="p-step">
          <div class="p-ic"><svg viewBox="0 0 24 24"><path d="M8 6 3 12l5 6M16 6l5 6-5 6M13 4l-2 16" /></svg></div>
          <div><div class="p-lbl">Founded</div><div class="p-val">2 May 1978 <b>· Jalandhar</b></div><div class="p-sub">Aid in education &amp; vocational training</div></div>
        </div>
        <div class="p-step">
          <div class="p-ic"><svg viewBox="0 0 24 24"><path d="M4 20V9l8-5 8 5v11" /><path d="M9 20v-6h6v6M4 20h16" /></svg></div>
          <div><div class="p-lbl">Scholarships</div><div class="p-val">265 students on scholarships</div><div class="p-sub">Class 9 through M.A. · plus vocational &amp; sports</div></div>
        </div>
        <div class="p-step hot">
          <div class="p-ic"><svg viewBox="0 0 24 24"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5L13 2z" /></svg></div>
          <div><div class="p-lbl">Grants in aid</div><div class="p-val">421 beneficiaries</div><div class="p-sub">Delivered at the doorstep, monthly</div></div>
        </div>
        <div class="p-step">
          <div class="p-ic"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><path d="M9 12l2 2 4-4" /></svg></div>
          <div><div class="p-lbl">Tax status</div><div class="p-val">80G exempt</div><div class="p-sub">Admin costs borne by the Trust</div></div>
        </div>
      </aside>
    </div>
  </header>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="mq-track">
      <span><i></i>Scholarships<i></i>Grants in aid<i></i>Vocational<i></i>Sports<i></i>80G exempt<i></i>Home-verified<i></i>Ideas Exchange<i></i>Annual reports</span>
      <span><i></i>Scholarships<i></i>Grants in aid<i></i>Vocational<i></i>Sports<i></i>80G exempt<i></i>Home-verified<i></i>Ideas Exchange<i></i>Annual reports</span>
    </div>
  </div>

  <!-- ============ MISSION ============ -->
  <section class="about" id="about">
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">01</span> · Mission &amp; Vision</p>
      <h2 class="h-sec rv">Aid in education <span class="hl">&amp; vocational training.</span></h2>
      <div class="a-grid">
        <aside class="card rv">
          <div class="fc-bar"><i></i><i></i><i></i><span>about-the-trust.txt</span></div>
          <div class="card-body" style="font-family:var(--f-mono);font-size:0.78rem;line-height:1.9;color:var(--ink-2)">
            <span class="mono" style="color:var(--navy)">name</span>&nbsp;&nbsp;&nbsp;&nbsp; F. C. Sondhi Charitable Trust<br />
            <span class="mono" style="color:var(--navy)">founded</span>&nbsp;&nbsp;&nbsp; 2 May 1978, Jalandhar<br />
            <span class="mono" style="color:var(--navy)">gives</span>&nbsp;&nbsp;&nbsp;&nbsp; Scholarships &amp; grants to the needy<br />
            <span class="mono" style="color:var(--navy)">how</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Studies each application, then sanctions aid<br />
            <span class="mono" style="color:var(--navy)">status</span>&nbsp;&nbsp;&nbsp; Every paisa reaches the beneficiary
          </div>
        </aside>
        <div class="tk-cols">
          <div class="card tk rv">
            <div class="ic"><svg viewBox="0 0 24 24"><path d="M22 10 12 5 2 10l10 5 10-5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg></div>
            <h3>Mission</h3>
            <ul><li>Help the needy — especially in education</li><li>Scholarships, Class 9 to M.A.</li><li>Vocational training grants</li></ul>
          </div>
          <div class="card tk rv">
            <div class="ic"><svg viewBox="0 0 24 24"><path d="M4 20V9l8-5 8 5v11" /><path d="M9 20v-6h6v6M4 20h16" /></svg></div>
            <h3>Grants</h3>
            <ul><li>₹850–₹1,000 a month</li><li>Elderly, widows, physically challenged</li><li>Delivered at their doorstep</li></ul>
          </div>
          <div class="card tk rv">
            <div class="ic"><svg viewBox="0 0 24 24"><path d="M12 21s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 11c0 5.65-7 10-7 10Z" /></svg></div>
            <h3>How it works</h3>
            <ul><li>Apply through the Trust office</li><li>Verified by a home visit</li><li>All genuine cases helped</li></ul>
          </div>
        </div>
      </div>
      <p class="note rv" style="margin-top:1.4rem">
        The Trust does this by studying applications from various institutions and individuals and
        sanctioning scholarships and grants in conformity with its ideals.
        <a href={url('/about-us/')} style="font-weight:700;color:var(--navy)">Read the founder&rsquo;s story &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <div class="stats">
    <div class="wrap row">
      <div><b>1978</b><span>Founded in Jalandhar</span></div>
      <div><b>265</b><span>Scholarships, session 2025–26</span></div>
      <div><b>421</b><span>Grant beneficiaries, FY 2025–26</span></div>
      <div><b>80G</b><span>All donations tax exempt</span></div>
    </div>
  </div>

  <!-- ============ THREE WAYS ============ -->
  <section>
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">02</span> · Get involved</p>
      <h2 class="h-sec rv">Three ways to <span class="hl">make a difference.</span></h2>
      <div class="w-grid">
        <a class="card pcard rv" href={url('/grants-scholarships/')} style="text-decoration:none">
          <div class="p-top"><div class="ic"><svg viewBox="0 0 24 24"><path d="M22 10 12 5 2 10l10 5 10-5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg></div><span class="p-num">01</span></div>
          <h3>Scholarships</h3>
          <p class="p-tags">Class 9 → M.A. · Vocational · Sports</p>
          <p class="d">From Class 9 through M.A. Every application is verified by a visit to the student&rsquo;s home. Sponsor a student from ₹1,500 a year.</p>
          <div class="p-link"><span>See scholarships &rarr;</span></div>
        </a>
        <a class="card pcard rv" href={url('/grants-scholarships/')} style="text-decoration:none">
          <div class="p-top"><div class="ic"><svg viewBox="0 0 24 24"><path d="M4 20V9l8-5 8 5v11" /><path d="M9 20v-6h6v6M4 20h16" /></svg></div><span class="p-num">02</span></div>
          <h3>Grants</h3>
          <p class="p-tags">Elderly &middot; Widows &middot; Physically challenged</p>
          <p class="d">₹850 a month, or ₹1,000 for special needs, for elderly and widowed people — delivered at the doorstep.</p>
          <div class="p-link"><span>See grants &rarr;</span></div>
        </a>
        <a class="card pcard rv" href={url('/how-to-donate/')} style="text-decoration:none">
          <div class="p-top"><div class="ic"><svg viewBox="0 0 24 24"><path d="M12 21s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 11c0 5.65-7 10-7 10Z" /></svg></div><span class="p-num">03</span></div>
          <h3>Give in someone&rsquo;s name</h3>
          <p class="p-tags">In memory &middot; In honour</p>
          <p class="d">Dedicate a scholarship or grant in the name of a loved one. All donations are exempt under Section 80G.</p>
          <div class="p-link"><span>How to donate &rarr;</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ LATEST UPDATE ============ -->
  <section class="band">
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">03</span> · Trust activities &amp; updates</p>
      <h2 class="h-sec rv">What we are <span class="hl">doing now.</span></h2>
      <div class="upd">
        <article class="rv" style="border-color:rgba(240,251,41,.35)">
          <time>{latest.period}</time>
          <div>
            <h3 style="color:#fff">{latest.title}</h3>
            {latest.paragraphs.map((p) => <p>{p}</p>)}
            <img class="rv" src={url('/images/activity.webp')} width="460" height="259" loading="lazy" alt="Photo from Charitable Trust Function held in March 2025" />
            <p style="font-size:.8rem;color:#9fb6c6;font-family:var(--f-mono)">Photo from Charitable Trust Function held in March 2025</p>
          </div>
        </article>
      </div>
      <div class="p-link rv" style="margin-top:1.6rem">
        <a href={url('/trust-activities-updates/')} style="color:var(--lime);border-bottom-color:var(--lime)">All quarterly updates
          <svg viewBox="0 0 24 24" style="stroke:var(--lime)"><path d="M7 17 17 7M9 7h8v8" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT TEASER ============ -->
  <section>
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">04</span> · Contact</p>
      <h2 class="h-sec rv">Reach the <span class="hl">Trust.</span></h2>
      <div class="c-grid">
        <div>
          <p class="lede rv">
            If you know a student who needs a scholarship, or an elderly person left without
            support, please bring them to our attention.
          </p>
          <div class="hero-cta rv" style="margin-top:1.4rem">
            <a class="cta" href={url('/contact/')}>Contact &amp; office hours
              <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a class="cta cta--ghost" href={url('/e-magazine/')}>Ideas Exchange archive</a>
          </div>
        </div>
        <ul class="socials rv">
          <li>
            <a href={`mailto:${SITE.email}`}>
              <span>Email</span><svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg>
            </a>
          </li>
          <li>
            <a href={`https://wa.me/${SITE.whatsapp}`} rel="noopener" target="_blank">
              <span>WhatsApp / SMS</span><svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg>
            </a>
          </li>
          <li>
            <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${SITE.address.street}, ${SITE.address.city}`)}`} rel="noopener" target="_blank">
              <span>{SITE.address.street}, {SITE.address.city}</span><svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .about .card-body .k {
    color: var(--navy);
    font-weight: 500;
  }
  .band .upd article {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.18);
  }
  .band .upd article p {
    color: #b9cad6;
  }
  .band .upd article time {
    color: var(--lime);
  }
  .band .upd article img {
    border-color: rgba(240, 251, 41, 0.35);
  }
</style>
