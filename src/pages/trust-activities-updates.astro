---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { UPDATES_NEWEST_FIRST } from '../data/site';

const updates = UPDATES_NEWEST_FIRST;
---

<Base
  title="Trust Activities & Updates"
  description="Quarterly updates from the F. C. Sondhi Charitable Trust — grant disbursals, new scholarship programmes, vocational education initiatives and beneficiary stories from Jalandhar."
>
  <PageHead
    eyebrow="Trust activities & updates"
    title="What we are doing now"
    lede="A quarterly account of disbursals, new programmes and the people behind them."
  />

  <!-- ============ SNAPSHOT ============ -->
  <section class="section-tight">
    <div class="wrap">
      <div class="stats rv" style="border:var(--bd);border-radius:12px;box-shadow:var(--sh);padding:0">
        <div class="row" style="padding:38px 14px">
          <div><b>₹70<em style="font-size:.35em;font-style:normal">lakh</em></b><span>Planned expenditure, grants &amp; scholarships</span></div>
          <div><b>₹36<em style="font-size:.35em;font-style:normal">lakh</em></b><span>Disbursed up to August 2026</span></div>
          <div><b>₹34<em style="font-size:.35em;font-style:normal">lakh</em></b><span>Earmarked for remaining commitments</span></div>
          <div><b>850+</b><span>Beneficiaries targeted</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ UPDATES ============ -->
  <section class="section-tight">
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">Quarterly log</span> · most recent first</p>
      <h2 class="h-sec rv">Updates, <span class="hl">quarter by quarter.</span></h2>
      <div class="upd">
        {
          updates.map((u) => (
            <article class="rv">
              <time>{u.period}</time>
              <div>
                <h3>{u.title}</h3>
                {u.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
                {u.image && (
                  <img
                    src={url(`/images/${u.image}`)}
                    alt={u.imageAlt}
                    width={u.imageWidth}
                    height={u.imageHeight}
                    loading="lazy"
                  />
                )}
              </div>
            </article>
          ))
        }
      </div>

      <div class="card pcard rv" style="margin-top:1.6rem">
        <div class="p-top"><div class="ic"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg></div><span class="p-num">Our promise</span></div>
        <h3>Timely, efficient, transparent</h3>
        <p class="d">
          We remain committed to supporting both existing and new beneficiaries through our grant
          and scholarship programmes. Our endeavour is to ensure that assistance reaches deserving
          individuals in a timely, efficient and transparent manner, while continuing our efforts
          to make a meaningful difference in their lives.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ DONOR CTA ============ -->
  <section class="band">
    <div class="wrap center">
      <p class="eyebrow rv"><span class="n" style="color:var(--lime)">Get involved</span></p>
      <h2 class="h-sec rv">Know someone who needs <span class="hl">a scholarship?</span></h2>
      <p class="rv" style="color:#b9cad6;max-width:50ch;margin:1.1rem auto 0">
        Application forms are available through the Trust office at 15 Adarsh Nagar, Jalandhar.
        Every application is verified by a home visit.
      </p>
      <div class="hero-cta rv" style="justify-content:center;margin-top:1.6rem">
        <a class="cta" href={url('/contact/')}>Contact the Trust<svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        <a class="cta cta--ghost" href={url('/grants-scholarships/')}>See eligibility &amp; amounts</a>
      </div>
    </div>
  </section>
</Base>
