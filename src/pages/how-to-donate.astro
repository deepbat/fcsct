---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { SITE, SPONSORSHIP_TIERS } from '../data/site';
---

<Base
  title="How to Donate"
  description="How to donate to the F. C. Sondhi Charitable Trust — by cheque, bank transfer (NEFT/RTGS) or UPI/Paytm. All donations are exempt under Section 80G. Jalandhar, Punjab."
>
  <PageHead
    eyebrow="How to donate"
    title="Every rupee reaches the student or needy person"
    lede="New rates apply for sponsoring a student's education, sports scholarships and grants in aid. All donations are exempted under section 80G."
  />

  <!-- ============ RATES ============ -->
  <section class="section-tight">
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">01</span> · New rates</p>
      <h2 class="h-sec rv">Sponsoring a student, <span class="hl">sports scholarship &amp; grants.</span></h2>
      <div class="a-grid" style="margin-top:1.6rem">
        <div class="card rv">
          <div class="fc-bar"><i></i><i></i><i></i><span>sponsorship-rates.txt</span></div>
          <div class="card-body">
            <p>
              The following annual amounts are sufficient to sponsor a student. You may adopt a
              child for one year, two years or more — and dedicate the scholarship in someone&rsquo;s
              name, for example in memory of a dear departed parent.
            </p>
            <div class="pills">
              <span class="pill pill--hot">80G exempt</span>
              <span class="pill">Adopt for 1 or more years</span>
              <span class="pill">Named after a loved one</span>
            </div>
          </div>
        </div>
        <div class="card card--invert pcard rv">
          <div class="p-top"><div class="ic" style="background:rgba(240,251,41,.15)"><svg viewBox="0 0 24 24" style="stroke:var(--lime)"><path d="M4 20V9l8-5 8 5v11" /><path d="M9 20v-6h6v6M4 20h16" /></svg></div><span class="p-num" style="color:#9fb6c6">Grant in aid</span></div>
          <h3>Elderly · young widows · physically challenged</h3>
          <p class="d" style="color:#b9cad6">
            <strong style="color:var(--lime)">₹10,200 per year</strong> is sufficient to take care
            of one old or destitute person, young widow or physically challenged person.
          </p>
          <div class="p-link">
            <a href={url('/grants-scholarships/')} style="color:var(--lime);border-bottom-color:var(--lime)">See all the schemes<svg viewBox="0 0 24 24" style="stroke:var(--lime)"><path d="M7 17 17 7M9 7h8v8" /></svg></a>
          </div>
        </div>
      </div>

      <div class="tbl-wrap rv">
        <table class="tbl">
          <caption>Student sponsorship — annual</caption>
          <thead>
            <tr>
              <th scope="col">Class / Course</th>
              <th scope="col">Amount</th>
            </tr>
          </thead>
          <tbody>
            {
              SPONSORSHIP_TIERS.map((t) => (
                <tr>
                  <th scope="row" style="font-weight:500">{t.stage}</th>
                  <td class="amt">{t.amount}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ WAYS TO PAY ============ -->
  <section class="band donate-band">
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">02</span> · Payment</p>
      <h2 class="h-sec rv">Three ways to <span class="hl">send your donation.</span></h2>
      <p class="rv" style="color:#b9cad6;max-width:56ch;margin-top:1.1rem">
        If you plan to sponsor a scholarship or grant, please share your email id or mobile number
        with us at <a href={`mailto:${SITE.email}`} style="color:var(--lime);font-weight:700">{SITE.email}</a>
        or WhatsApp <a href={`https://wa.me/${SITE.whatsapp}`} style="color:var(--lime);font-weight:700">{SITE.phone}</a>.
      </p>

      <div class="w-grid" style="grid-template-columns:repeat(auto-fit,minmax(min(330px,100%),1fr))">
        <div class="card pcard rv">
          <div class="p-top"><div class="ic" style="background:rgba(240,251,41,.15)"><svg viewBox="0 0 24 24" style="stroke:var(--lime)"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /></svg></div><span class="p-num" style="color:#9fb6c6">01 · NEFT / RTGS</span></div>
          <h3>Bank transfer</h3>
          <dl>
            <dt>Beneficiary</dt>
            <dd>{SITE.bank.beneficiary}</dd>
            <dt>Bank</dt>
            <dd>{SITE.bank.bankName}</dd>
            <dt>Account no.</dt>
            <dd id="acc">{SITE.bank.accountNumber}</dd>
            <dt>IFSC code</dt>
            <dd id="ifsc">{SITE.bank.ifsc}</dd>
          </dl>
          <button class="copy" id="cp" type="button">Copy account details</button>
        </div>

        <div class="card pcard rv" style="text-align:center">
          <div class="p-top"><div class="ic" style="background:rgba(240,251,41,.15)"><svg viewBox="0 0 24 24" style="stroke:var(--lime)"><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M9 9h6v6H9zM9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3" /></svg></div><span class="p-num" style="color:#9fb6c6">02 · UPI / Paytm</span></div>
          <h3>Scan the QR code</h3>
          <div class="qr"><img src={url('/images/paytm-qr.webp')} width="240" height="240" loading="lazy" alt="Paytm QR code for FC Sondhi Charitable" /></div>
          <p class="d" style="color:#b9cad6">
            Scan the QR code, then inform us by SMS, call or WhatsApp on
            <a href={`tel:+${SITE.whatsapp}`} style="color:#fff">{SITE.phone}</a> so that we can
            record the donation against your name.
          </p>
        </div>

        <div class="card pcard rv">
          <div class="p-top"><div class="ic" style="background:rgba(240,251,41,.15)"><svg viewBox="0 0 24 24" style="stroke:var(--lime)"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /><path d="M9 13h6M9 17h4" /></svg></div><span class="p-num" style="color:#9fb6c6">03 · By cheque</span></div>
          <h3>Cheque / DD</h3>
          <p class="d" style="color:#b9cad6">
            Make it out to <strong style="color:#fff">F.C. Sondhi Charitable Trust</strong> and
            send it to 15 Adarsh Nagar, Jalandhar – 144008. Please mention your name and phone
            number so we can acknowledge your gift.
          </p>
          <div class="p-note" style="border-color:rgba(255,255,255,.2);color:#9fb6c6"><b style="color:var(--lime)">Tax note</b>All donations are exempted under section 80G. Keep your donation receipt for your return.</div>
          <div class="p-link">
            <a href={url('/contact/')} style="color:var(--lime);border-bottom-color:var(--lime)">Contact &amp; office hours<svg viewBox="0 0 24 24" style="stroke:var(--lime)"><path d="M7 17 17 7M9 7h8v8" /></svg></a>
          </div>
        </div>
      </div>

      <div class="hero-cta rv" style="margin-top:2rem">
        <a class="cta" href={`https://wa.me/${SITE.whatsapp}`} rel="noopener" target="_blank">WhatsApp the Trust<svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg></a>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  document.getElementById('cp')?.addEventListener('click', function () {
    var s =
      'F.C. Sondhi Charitable Trust\nUnion Bank of India, Basti Nau, Jalandhar\nA/c: ' +
      document.getElementById('acc').textContent +
      '\nIFSC: ' +
      document.getElementById('ifsc').textContent;
    var b = this;
    var ok = function () {
      b.textContent = 'Copied!';
    };
    var fb = function () {
      b.textContent = 'Copy not available';
    };
    try {
      (navigator.clipboard ? navigator.clipboard.writeText(s) : Promise.reject()).then(ok, fb);
    } catch (e) {
      fb();
    }
    setTimeout(function () {
      b.textContent = 'Copy account details';
    }, 2200);
  });
</script>
