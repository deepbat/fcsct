---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { SPONSORSHIP_TIERS } from '../data/site';

const notes = [
  {
    title: 'Class 9 to M.A. welcome',
    body: 'We first offered scholarships to all school-going children, but realised the cost of education in the lower classes is nominal. We now entertain applications from Class 9 through M.A.',
  },
  {
    title: 'Every application verified at home',
    body: 'Each application is verified by a visit to the home of the student, to confirm the facts entered on the fairly comprehensive application form. Our aim is to help all genuine cases who come to us.',
  },
  {
    title: 'Donor money, donor intent',
    body: 'Many of our scholarships are sponsored by donors. Our policy is that every paisa of donated money is issued for the scholarship, and all administration costs are borne by the Trust.',
  },
];
---

<Base
  title="Scholarships & Grants"
  description="Annual sponsorship amounts for a student's education, from Class 1 to post-graduation, plus vocational and sports scholarships and monthly grants for the elderly and widows. F. C. Sondhi Charitable Trust, Jalandhar."
>
  <PageHead
    eyebrow="Our schemes"
    title="Scholarships & Grants"
    lede="Sponsor a student for a year, two years or longer — or adopt an elderly person, widow or physically challenged beneficiary for a monthly grant."
  />

  <!-- ============ SCHOLARSHIPS ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Scholarships</p>
        <h2>Sponsoring a student’s education</h2>
        <p>
          The Trust has been giving scholarships for the last 40 years or so. The following
          annual amounts are sufficient to sponsor a student.
        </p>
      </div>

      <div class="table-wrap">
        <table>
          <caption>Annual sponsorship amounts</caption>
          <thead>
            <tr>
              <th scope="col">Class / Course</th>
              <th scope="col">Annual sponsorship</th>
            </tr>
          </thead>
          <tbody>
            {
              SPONSORSHIP_TIERS.map((t) => (
                <tr>
                  <th scope="row">{t.stage}</th>
                  <td class="amount">
                    {t.amount} <span class="unit">{t.note}</span>
                  </td>
                </tr>
              ))
            }
            <tr>
              <th scope="row">B.A. &amp; M.A. / B.Sc. &amp; M.Sc.</th>
              <td class="amount">According to financial need — up to 75% of cost of education</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mt-4 measure">
        You may adopt a child for one year, two years or more.
      </p>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section section--alt section--tight">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>Three things worth knowing</h2>
      </div>
      <div class="grid grid--3">
        {
          notes.map((n, i) => (
            <div class="card">
              <span class="step">{String(i + 1).padStart(2, '0')}</span>
              <h3>{n.title}</h3>
              <p class="note-body">{n.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ NUMBERS ============ -->
  <section class="section section--brand">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Session 2025–26</p>
        <h2>Scholarships being given</h2>
        <p>A total of 265 students received scholarships in the academic session 2025–26.</p>
      </div>
      <ul class="grid grid--4 numbers">
        <li class="stat">
          <span class="stat__value">265</span>
          <span class="stat__label">Total scholarships</span>
        </li>
        <li class="stat">
          <span class="stat__value">16</span>
          <span class="stat__label">Vocational scholarships</span>
        </li>
        <li class="stat">
          <span class="stat__value">6</span>
          <span class="stat__label">Sports scholarships</span>
        </li>
        <li class="stat">
          <span class="stat__value">9</span>
          <span class="stat__label">Government schools in the vocational programme</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ GRANTS ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Grants</p>
        <h2>Grants to the needy</h2>
        <p>
          There are surprisingly, even in India where the joint family prevails, many elderly
          ladies — and even a few elderly gentlemen — who have absolutely no income and very
          little support. Most of them are over the age of 60.
        </p>
      </div>

      <div class="grid grid--2">
        <div class="card grant">
          <span class="pill">Old age · Disability</span>
          <h3>Adopting an elderly person</h3>
          <p class="note-body">
            Their families have deserted them and they do not have the capacity to work any
            longer. If you would like to adopt an elderly person, please send your
            contributions in multiples of:
          </p>
          <ul class="ticks">
            <li><strong>₹10,200 / ₹12,000</strong> — for one year</li>
            <li><strong>₹20,400 / ₹24,000</strong> — for two years</li>
            <li><strong>…and so on</strong> — for as many years as you wish</li>
          </ul>
        </div>

        <div class="card grant">
          <span class="pill pill--gold">Widows &amp; widowers</span>
          <h3>Grants to widows</h3>
          <p class="note-body">
            After starting the scholarship scheme, it came to our notice that widows faced many
            problems. A scheme was started to give grants to widows — elderly widows and other
            destitute people — at ₹850 or ₹1,000 per month at present.
          </p>
          <ul class="ticks">
            <li>Financial aid of <strong>₹850–₹1,000 per month</strong></li>
            <li>Delivered <strong>at the doorstep</strong> — beneficiaries are quite aged</li>
            <li><strong>421</strong> total beneficiaries in FY 2025–26</li>
          </ul>
        </div>
      </div>

      <div class="callout mt-6">
        <span class="callout__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </span>
        <div>
          <h3>Dedicate a grant in someone’s name</h3>
          <p>
            If you would like to dedicate a scholarship or grant in someone’s name — perhaps a
            dear departed parent — it can be named after that person, for example
            <em>Sushila Khanna Scholarship</em> and/or Grant.
          </p>
        </div>
      </div>

      <div class="cta-row mt-7">
        <a class="btn btn--primary" href={url('/how-to-donate/')}>How to Donate</a>
        <a class="btn btn--ghost" href={url('/contact/')}>Talk to the Trust</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .unit {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .step {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-full);
    background: var(--green-50);
    border: 1px solid var(--green-100);
    color: var(--green-700);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .card h3 {
    margin-top: var(--sp-4);
  }

  .note-body {
    margin-top: var(--sp-3);
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .numbers {
    list-style: none;
    padding: 0;
    margin: 0;
    row-gap: var(--sp-5);
  }

  .section--brand .section-head p {
    color: rgb(255 255 255 / 0.75);
  }

  .ticks {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 0;
    display: grid;
    gap: var(--sp-3);
    font-size: 0.9375rem;
    color: var(--ink-700);
  }

  .ticks li {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
  }

  .ticks li::before {
    content: '';
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: var(--gold-500);
  }

  .ticks strong {
    color: var(--green-800);
    font-weight: 600;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
</style>
