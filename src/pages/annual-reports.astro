---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { SITE } from '../data/site';
---

<Base
  title="Annual Reports"
  description="Balance Sheet and Income & Expenditure Account of the F. C. Sondhi Charitable Trust as on 31 March 2025."
>
  <PageHead
    eyebrow="Annual reports"
    title="Open books"
    lede="Balance Sheet and Income & Expenditure Account as on 31-03-2025."
  />

  <!-- ============ REPORT ============ -->
  <section class="section-tight">
    <div class="wrap">
      <div class="a-grid" style="margin-top:0">
        <div class="card rv">
          <div class="fc-bar"><i></i><i></i><i></i><span>annual-report-2024-25.pdf</span></div>
          <div class="card-body">
            <span class="badge"><svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /></svg>As on 31-03-2025</span>
            <h2 class="h-item" style="margin-top:1rem;font-size:1.5rem">Balance Sheet &amp; Income &amp; Expenditure Account</h2>
            <p style="margin-top:0.7rem;color:var(--ink-2)">
              The audited accounts of the Trust for the financial year ended 31 March 2025. Reports
              from earlier years are available on request from the Trust office, and can be
              inspected during office hours.
            </p>
            <div class="hero-cta" style="margin-top:1.3rem">
              <button class="cta" type="button" data-zoom>View the report<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.35-4.35M11 8v6M8 11h6" /></svg></button>
              <a class="cta cta--ghost" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Request for Annual Report 2024-25')}`}>Request past years</a>
            </div>
          </div>
        </div>
        <figure class="card report-fig rv">
          <img
            class="report-img"
            src={url('/images/balance-sheet.webp')}
            alt="Balance sheet and income and expenditure account as on 31-03-2025"
            loading="lazy"
            data-zoom
          />
          <figcaption class="mono" style="padding:0.7rem 0.9rem;color:var(--muted)">Tap or click to zoom</figcaption>
        </figure>
      </div>

      <dialog id="dlg" class="lb" aria-label="Balance sheet, enlarged">
        <div class="lb-in">
          <div class="lb-bar">
            <span>Balance Sheet &amp; Income &amp; Expenditure — 31-03-2025</span>
            <button class="lb-close" id="dlg-close" type="button" aria-label="Close">
              <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          </div>
          <div class="lb-stage"><img id="dimg" src={url('/images/balance-sheet.webp')} alt="Balance sheet and income and expenditure account as on 31-03-2025" /></div>
        </div>
      </dialog>
    </div>
  </section>

  <!-- ============ ACCOUNTABILITY ============ -->
  <section class="band">
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">Accountability</span></p>
      <h2 class="h-sec rv">Where the <span class="hl">money goes.</span></h2>
      <div class="w-grid" style="grid-template-columns:repeat(auto-fit,minmax(min(330px,100%),1fr))">
        <div class="card pcard rv" style="background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.35)">
          <div class="p-top"><div class="ic" style="background:rgba(240,251,41,.15)"><svg viewBox="0 0 24 24" style="stroke:var(--lime)"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><path d="M9 12l2 2 4-4" /></svg></div><span class="p-num" style="color:#9fb6c6">80G</span></div>
          <h3 style="color:#fff">Tax exempt</h3>
          <p class="d" style="color:#b9cad6">All donations to the Trust are exempted under section 80G.</p>
        </div>
        <div class="card pcard rv" style="background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.35)">
          <div class="p-top"><div class="ic" style="background:rgba(240,251,41,.15)"><svg viewBox="0 0 24 24" style="stroke:var(--lime)"><path d="M4 20V9l8-5 8 5v11" /><path d="M9 20v-6h6v6M4 20h16" /></svg></div><span class="p-num" style="color:#9fb6c6">Home visits</span></div>
          <h3 style="color:#fff">Verified before we pay</h3>
          <p class="d" style="color:#b9cad6">Every scholarship application is confirmed by a visit to the student&rsquo;s home.</p>
        </div>
        <div class="card pcard rv" style="background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.35)">
          <div class="p-top"><div class="ic" style="background:rgba(240,251,41,.15)"><svg viewBox="0 0 24 24" style="stroke:var(--lime)"><rect x="3" y="4" width="18" height="14" rx="2" /><path d="M3 9h18M8 21h8" /></svg></div><span class="p-num" style="color:#9fb6c6">Quarterly</span></div>
          <h3 style="color:#fff">Published updates</h3>
          <p class="d" style="color:#b9cad6">Disbursals and programme updates are published every quarter for donors to review.</p>
        </div>
      </div>
      <p class="rv" style="margin-top:1.4rem;color:#9fb6c6;font-size:.95rem">
        If you would like to see how a specific donation was used, ask us — we will tell you.
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var dlg = document.getElementById('dlg');
    if (!dlg) return;
    document.querySelectorAll('[data-zoom]').forEach(function (el) {
      el.addEventListener('click', function () {
        dlg.showModal();
      });
    });
    document.getElementById('dlg-close').onclick = function () {
      dlg.close();
    };
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) dlg.close();
    });
  })();
</script>

<style>
  .report-fig img {
    width: 100%;
    max-height: 520px;
    object-fit: contain;
    object-position: top;
    background: #fff;
    cursor: zoom-in;
    border-bottom: var(--bd);
  }
  .lb {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 94vw;
    max-height: 94vh;
  }
  .lb::backdrop {
    background: rgba(4, 27, 42, 0.9);
  }
  .lb-in {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
  }
  .lb-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem var(--pad);
    color: #e8f3fa;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .lb-close {
    background: var(--lime);
    border: 2px solid var(--lime);
    border-radius: 8px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex: none;
  }
  .lb-close svg {
    width: 16px;
    height: 16px;
    stroke: #052b42;
    stroke-width: 2.4;
    fill: none;
    stroke-linecap: round;
  }
  .lb-stage {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 0 var(--pad) 1.2rem;
  }
  .lb-stage img {
    max-height: 78vh;
    max-width: 92vw;
    border: 3px solid #e8f3fa;
    border-radius: 10px;
    background: #fff;
  }
</style>
