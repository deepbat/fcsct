---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { SITE } from '../data/site';

const mapQuery = encodeURIComponent(
  `${SITE.address.street}, ${SITE.address.city} ${SITE.address.postalCode}, ${SITE.address.state}, ${SITE.address.country}`,
);
---

<Base
  title="Contact Us"
  description="Contact the F. C. Sondhi Charitable Trust — 15 Adarsh Nagar, Jalandhar 144008, Punjab. Email fcsondhitrust@gmail.com or WhatsApp 81980-62233."
>
  <PageHead
    eyebrow="Contact us"
    title="Reach the Trust"
    lede="If you know a student who needs a scholarship, or an elderly person left without support, please bring them to our attention."
  />

  <!-- ============ CHANNELS ============ -->
  <section class="section-tight">
    <div class="wrap">
      <ul class="socials rv" style="max-width:560px">
        <li>
          <a href={`mailto:${SITE.email}`}>
            <span>Email</span>
            <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg>
          </a>
        </li>
        <li>
          <a href={`https://wa.me/${SITE.whatsapp}`} rel="noopener" target="_blank">
            <span>WhatsApp / SMS — {SITE.phone}</span>
            <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg>
          </a>
        </li>
        <li>
          <a href={`tel:+${SITE.whatsapp}`}>
            <span>Call the office</span>
            <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg>
          </a>
        </li>
      </ul>
      <p class="note rv" style="margin-top:1.2rem">
        Application forms for scholarships and vocational courses are available at the Trust
        office. Forms are also sent out by post, on request.
      </p>
    </div>
  </section>

  <!-- ============ MAP ============ -->
  <section class="section-tight">
    <div class="wrap">
      <div class="a-grid" style="margin-top:0;grid-template-columns:1fr">
        <aside class="card rv">
          <div class="fc-bar"><i></i><i></i><i></i><span>address.txt</span></div>
          <div class="card-body" style="font-family:var(--f-mono);font-size:0.8rem;line-height:1.95;color:var(--ink-2)">
            <span style="color:var(--navy);font-weight:500">name</span>&nbsp;&nbsp;&nbsp; F. C. Sondhi Charitable Trust<br />
            <span style="color:var(--navy);font-weight:500">street</span>&nbsp;&nbsp;&nbsp; {SITE.address.street}<br />
            <span style="color:var(--navy);font-weight:500">city</span>&nbsp;&nbsp;&nbsp;&nbsp; {SITE.address.city} {SITE.address.postalCode}<br />
            <span style="color:var(--navy);font-weight:500">state</span>&nbsp;&nbsp;&nbsp; {SITE.address.state}, {SITE.address.country}
          </div>
        </aside>
        <div class="map rv">
          <iframe
            title="Map showing the F. C. Sondhi Charitable Trust office at 15 Adarsh Nagar, Jalandhar"
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
            width="100%"
            height="100%"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>
      <div class="hero-cta rv" style="margin-top:1.8rem">
        <a class="cta" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} rel="noopener" target="_blank">Open in Google Maps<svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg></a>
        <a class="cta cta--ghost" href={url('/how-to-donate/')}>How to Donate</a>
      </div>
    </div>
  </section>
</Base>
