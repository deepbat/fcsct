---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

const chapters = [
  {
    kicker: '01 — Childhood',
    title: 'Orphaned at three, raised by relatives',
    body: [
      'Mr. F. C. Sondhi, a great philanthropist and self-made businessman, was born in 1906 in Sialkot — now in Pakistan. Both his parents died when he was three years old and he was left to grow up in the home of some relatives.',
    ],
  },
  {
    kicker: '02 — Beliefs',
    title: 'Hard work, honest study, upliftment',
    body: [
      'From a very young age he believed in hard, diligent and honest study, and at the same time was deeply committed to the upliftment of the downtrodden. He was an active member of the Arya Samaj movement in those days.',
      'Through his own hard work and self-education he did well in his academic studies and was called by the then major sports company in United India, M/s Uberoi Limited, to work there. He developed a shining reputation for honesty and was put under the personal supervision of Mr. Uberoi himself.',
    ],
  },
  {
    kicker: '03 — Career',
    title: 'England, then a life of returns to India',
    body: [
      'In 1936 he was sent to England and eventually settled down there. However, he had a great yearning to visit his motherland and came to India often.',
      'From 1967 — when his younger son came and settled in Jalandhar — till 1983, when he passed away, he visited India every year for periods of three to six months at a time, and got deeply involved in projects for helping the poor and the needy. He was also here for one full year in 1972–73, as President of the local Rotary Club.',
    ],
  },
  {
    kicker: '04 — Philosophy',
    title: 'Equality, and belief in action',
    body: [
      'Late Mr. F. C. Sondhi was a spiritually minded philanthropist and self-made businessman. He believed in treating all human beings as equal, irrespective of caste and creed.',
      'He also believed in a universal religion without dogma. And he was a great believer in action, which was exemplified by his life work. That is why the Trust was started.',
    ],
  },
];
---

<Base
  title="About Us"
  description="The life, beliefs and philosophy of Mr. F. C. Sondhi (1906–1983), founder of the F. C. Sondhi Charitable Trust, established in Jalandhar on 2 May 1978."
>
  <PageHead
    eyebrow="About us"
    title="The founder"
    lede="A self-made businessman who returned to India for sixteen years running to serve the poor — and left behind a trust still doing the same."
  />

  <section class="section">
    <div class="wrap">
      <div class="portrait">
        <div class="portrait__mark" aria-hidden="true">
          <span>F.C.S.</span>
          <small>1906 — 1983</small>
        </div>
        <div class="prose">
          <h2>Mr. F. C. Sondhi</h2>
          <p class="lede">
            Our founder. Philanthropist, businessman, and a man who believed that belief
            without action was worth very little.
          </p>
        </div>
      </div>

      <ol class="chapters mt-7">
        {
          chapters.map((c) => (
            <li class="chapter">
              <p class="chapter__kicker">{c.kicker}</p>
              <h3 class="chapter__title">{c.title}</h3>
              <div class="chapter__body">
                {c.body.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head section-head--center">
        <p class="eyebrow">The Trust today</p>
        <h2>His philosophy, still in practice</h2>
      </div>
      <div class="grid grid--3">
        <div class="card">
          <h3>Equal regard</h3>
          <p class="card__body">
            Aid is given on need alone — never on caste, creed or connection. Applications are
            verified by a visit to the applicant’s home.
          </p>
        </div>
        <div class="card">
          <h3>Action over words</h3>
          <p class="card__body">
            The Trust has been sanctioning scholarships and grants continuously since 2 May
            1978, without a break.
          </p>
        </div>
        <div class="card">
          <h3>Donor trust</h3>
          <p class="card__body">
            Every paisa of donated money is issued for the scholarship or grant it was given
            for. All administration costs are borne by the Trust itself.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .portrait {
    display: grid;
    gap: var(--sp-5);
    align-items: center;
  }

  @media (min-width: 860px) {
    .portrait {
      grid-template-columns: 240px 1fr;
      gap: var(--sp-8);
    }
  }

  .portrait__mark {
    display: grid;
    place-items: center;
    gap: 0.5rem;
    aspect-ratio: 1;
    border-radius: var(--r-xl);
    background: radial-gradient(circle at 30% 25%, var(--green-700), var(--green-900));
    box-shadow: var(--shadow-lg);
  }

  .portrait__mark span {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.25rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--gold-500);
  }

  .portrait__mark small {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: rgb(255 255 255 / 0.6);
  }

  /* Chapters */
  .chapters {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-4);
  }

  @media (min-width: 900px) {
    .chapters {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-5);
    }
  }

  .chapter {
    padding: var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
  }

  .chapter__kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-700);
  }

  .chapter__title {
    margin-top: var(--sp-3);
  }

  .chapter__body {
    margin-top: var(--sp-3);
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .chapter__body p + p {
    margin-top: var(--sp-3);
  }

  .card__body {
    margin-top: var(--sp-3);
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
</style>
