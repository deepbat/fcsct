---
import { url } from '../lib/urls';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

const chapters = [
  {
    n: '01',
    kicker: 'Childhood',
    title: 'Born in 1906, orphaned at three',
    body: [
      'Mr. F. C. Sondhi, a great philanthropist and self made businessman, was born in 1906 in Sialkot — now in Pakistan. Both his parents died when he was three years old, and he was left to grow up in the home of some relatives.',
    ],
  },
  {
    n: '02',
    kicker: 'Beliefs',
    title: 'Hard, diligent and honest study',
    body: [
      'From a very young age he believed in hard, diligent and honest study and, at the same time, was deeply committed to the upliftment of the downtrodden. He was an active member of the Arya Samaj movement in those days.',
      'Through his own hard work and self education he did well in his academic studies, and was called by the then major sports company in United India, M/s Uberoi Limited, to work there. He developed a shining reputation for honesty and was put under the personal supervision of Mr. Uberoi himself.',
    ],
  },
  {
    n: '03',
    kicker: 'Career',
    title: 'England — and a life of returns to India',
    body: [
      'In 1936 he was sent to England and eventually settled down there. However, he had a great yearning to visit his motherland and came to India often.',
      'From 1967 — when his younger son came and settled in Jalandhar — till 1983, when he passed away, he used to visit India every year for periods of three to six months at a time, and got deeply involved in projects for helping the poor and the needy. He was also here for one full year in 1972–1973, as President of the local Rotary Club.',
    ],
  },
  {
    n: '04',
    kicker: 'Philosophy',
    title: 'Equality — and belief in action',
    body: [
      'Late Mr. F. C. Sondhi was a spiritually minded philanthropist and self made businessman. He believed in treating all human beings as equal, irrespective of caste and creed. He also believed in a universal religion without dogma.',
      'He was also a great believer in action, which was exemplified by his life work. That is why the Trust was started.',
    ],
  },
];
---

<Base
  title="About Us"
  description="The life, beliefs and philosophy of Mr. F. C. Sondhi (1906–1983), founder of the F. C. Sondhi Charitable Trust, established in Jalandhar on 2 May 1978."
>
  <PageHead
    eyebrow="About us"
    title="Our Founder"
    lede="A great philanthropist and self made businessman, born in 1906 in Sialkot, now in Pakistan."
  />

  <!-- ============ FOUNDER ============ -->
  <section class="section-tight">
    <div class="wrap">
      <div class="a-grid" style="margin-top:0;align-items:start">
        <aside class="card rv founder-card">
          <div class="fc-bar"><i></i><i></i><i></i><span>fc-sondhi.txt</span></div>
          <div class="founder-photo">
            <img src={url('/images/ph-founder.webp')} width="480" height="468" loading="lazy" alt="Mr. F. C. Sondhi, founder" />
          </div>
          <div class="card-body" style="text-align:center">
            <h2 class="h-item" style="font-size:1.35rem">Mr. F. C. Sondhi</h2>
            <p class="mono" style="color:var(--muted);margin-top:0.4rem">FC Sondhi · 1906 – 1983 · Founder</p>
          </div>
        </aside>

        <div>
          <div class="tl" style="margin-top:0">
            {
              chapters.map((c) => (
                <div class="rv">
                  <b>{c.n} · {c.kicker}</b>
                  <div>
                    <h3 class="h-item">{c.title}</h3>
                    {c.body.map((p) => (
                      <span style="display:block;margin-top:0.55rem">{p}</span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PHILOSOPHY IN PRACTICE ============ -->
  <section class="band">
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">Philosophy</span> · The Trust today</p>
      <h2 class="h-sec rv">His philosophy, <span class="hl">still in practice.</span></h2>
      <div class="w-grid" style="grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr))">
        <div class="card pcard rv donate-today">
          <div class="p-top"><div class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z" /></svg></div><span class="p-num">Equal regard</span></div>
          <h3 style="color:#fff">All human beings are equal</h3>
          <p class="d" style="color:#b9cad6">Aid is given on need alone — never on caste, creed or connection. Applications are verified by a visit to the applicant&rsquo;s home.</p>
        </div>
        <div class="card pcard rv">
          <div class="p-top"><div class="ic"><svg viewBox="0 0 24 24"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5L13 2z" /></svg></div><span class="p-num">Action over words</span></div>
          <h3 style="color:#fff">A great believer in action</h3>
          <p class="d" style="color:#b9cad6">The Trust has been sanctioning scholarships and grants continuously since 2 May 1978 — without a break.</p>
        </div>
        <div class="card pcard rv">
          <div class="p-top"><div class="ic"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" /><path d="M9 12l2 2 4-4" /></svg></div><span class="p-num">Donor trust</span></div>
          <h3 style="color:#fff">Every paisa accounted for</h3>
          <p class="d" style="color:#b9cad6">Every paisa of donated money is issued for the scholarship or grant it was given for, and all administration costs are borne by the Trust itself.</p>
        </div>
      </div>
      <div class="hero-cta rv" style="margin-top:2rem">
        <a class="cta" href={url('/grants-scholarships/')}>See the schemes<svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        <a class="cta cta--ghost" href={url('/trust-activities-updates/')}>What we&rsquo;re doing now</a>
      </div>
    </div>
  </section>

  <!-- ============ AWARDS PHOTO ============ -->
  <section>
    <div class="wrap">
      <p class="eyebrow rv"><span class="n">Archive</span> · Awards Function</p>
      <h2 class="h-sec rv">The work, <span class="hl">in pictures.</span></h2>
      <div class="ph-grid ph-grid--3">
        <figure class="ph-item rv">
          <img src={url('/images/awards-2.webp')} loading="lazy" alt="Awards Function photograph from the original homepage" />
          <figcaption><span>Awards Function</span><span>01</span></figcaption>
        </figure>
        <figure class="ph-item rv">
          <img src={url('/images/stage.webp')} loading="lazy" alt="Scholarship recipients on stage at the Awards Function" />
          <figcaption><span>On stage</span><span>02</span></figcaption>
        </figure>
        <figure class="ph-item rv">
          <img src={url('/images/collage.webp')} loading="lazy" alt="Photographs from the Trust's Awards Function, 25 March 2018" />
          <figcaption><span>Awards collage · 25 Mar 2018</span><span>03</span></figcaption>
        </figure>
      </div>
    </div>
  </section>
</Base>

<style>
  .founder-photo {
    padding: 0.9rem 0.9rem 0;
  }
  .founder-card img {
    border: var(--bd);
    border-radius: 8px;
    width: 100%;
  }
  .band .pcard {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.35);
  }
  html.dark .band .pcard {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .band .pcard .ic {
    background: rgba(240, 251, 41, 0.15);
  }
  .band .pcard .ic svg {
    stroke: var(--lime);
  }
  .band .pcard:hover {
    box-shadow: 11px 11px 0 rgba(0, 0, 0, 0.35);
  }
</style>
