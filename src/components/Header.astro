---
import { url } from '../lib/urls';
import { NAV, SITE } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isActive = (href: string) => {
  const path = href.replace(/\/$/, '') || '/';
  const cur = currentPath.replace(/\/$/, '') || '/';
  return path === '/' ? cur === '/' : cur.startsWith(path);
};

const donateHref = NAV.find((i) => i.href.includes('donate'))?.href ?? '/how-to-donate/';
---

<div class="annc">Helping the needy learn, live and hope.&nbsp; — &nbsp;<b>Serving Jalandhar since 2 May 1978</b></div>
<nav class="nav" id="nav" aria-label="Primary">
  <a class="brand" href={url('/')} aria-label={`${SITE.name}, back to the top`}>
    <span class="mark" aria-hidden="true">FCS</span>
    <span class="brand-txt">
      <span class="b-name">F. C. Sondhi Charitable Trust</span>
      <span class="b-sub">Jalandhar &middot; Since 1978</span>
    </span>
  </a>

  <ul class="nav-links" id="navlinks">
    {
      NAV.map((item) => (
        <li>
          <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="nav-actions">
    <button
      class="icon-btn theme"
      id="theme"
      type="button"
      aria-label="Toggle dark mode"
      title="Theme: auto / light / dark"
    >
      <svg class="i-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5v17a8.5 8.5 0 0 0 0-17Z" fill="currentColor" /></svg>
      <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
      <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" /></svg>
    </button>
    <button class="icon-btn" id="menu" type="button" aria-expanded="false" aria-controls="m-panel" aria-label="Open menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <a class="cta cta--sm donate-cta" href={url(donateHref)}>Donate</a>
  </div>
</nav>

<div class="mobile" id="m-panel" hidden>
  <ul class="mobile__list wrap">
    {
      NAV.map((item) => (
        <li>
          <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mobile__foot wrap">
    <a class="cta" href={url(donateHref)}>Donate</a>
    <div class="mobile__contact mono">
      <a href={`tel:+${SITE.whatsapp}`}>{SITE.phone}</a>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
</div>

<div id="tm-note" role="status">Theme</div>

<style>
  /* Sticky pill nav */
  .nav {
    position: sticky;
    top: 10px;
    z-index: 50;
    margin: 10px var(--pad) 0;
    background: #052b42;
    color: #f2f7fa;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 64px;
    padding: 0 0.8rem 0 1rem;
    box-shadow: 8px 8px 0 rgba(5, 43, 66, 0.14);
  }
  html.dark .nav {
    background: #041b2a;
    box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.4);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: #fff;
    min-width: 0;
  }
  .brand .mark {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--lime);
    color: #052b42;
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.03em;
    flex: none;
  }
  .brand-txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .b-name {
    font-weight: 800;
    font-size: 1.02rem;
    letter-spacing: -0.02em;
    line-height: 1.05;
    white-space: nowrap;
  }
  .b-sub {
    font-family: var(--f-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9fb6c6;
    white-space: nowrap;
  }

  .nav-links {
    display: none;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    text-decoration: none;
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c7d8e3;
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .nav-links a:hover,
  .nav-links a[aria-current] {
    color: var(--lime);
    border-bottom-color: var(--lime);
  }

  .nav-actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex: none;
  }
  .icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    border: 2px solid rgba(255, 255, 255, 0.25);
    background: transparent;
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex: none;
  }
  .icon-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-btn:hover {
    border-color: var(--lime);
    color: var(--lime);
  }
  .donate-cta {
    color: #052b42;
    white-space: nowrap;
  }

  /* theme icon visibility */
  .theme .i-moon,
  .theme .i-sun {
    display: none;
  }
  html[data-tm='light'] .theme .i-sun {
    display: block;
  }
  html[data-tm='light'] .theme .i-auto,
  html[data-tm='light'] .theme .i-moon {
    display: none;
  }
  html[data-tm='dark'] .theme .i-moon {
    display: block;
  }
  html[data-tm='dark'] .theme .i-auto,
  html[data-tm='dark'] .theme .i-sun {
    display: none;
  }

  /* Mobile panel */
  .mobile {
    position: absolute;
    z-index: 40;
    left: 0.8rem;
    right: 0.8rem;
    top: 84px;
    background: #052b42;
    color: #f2f7fa;
    border: 2px solid rgba(255, 255, 255, 0.18);
    border-radius: 14px;
    box-shadow: 8px 8px 0 rgba(5, 43, 66, 0.35);
    padding: 0.4rem 0 1rem;
  }
  html.dark .mobile {
    background: #041b2a;
  }
  .mobile__list {
    list-style: none;
    margin: 0;
  }
  .mobile__list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0.4rem;
    border-bottom: 1.5px dashed rgba(255, 255, 255, 0.14);
    text-decoration: none;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c7d8e3;
  }
  .mobile__list li:last-child a {
    border-bottom: 0;
  }
  .mobile__list a:hover,
  .mobile__list a[aria-current] {
    color: var(--lime);
  }
  .mobile__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
  }
  .mobile__contact {
    display: grid;
    gap: 0.3rem;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9fb6c6;
  }
  .mobile__contact a {
    color: #c7d8e3;
    text-decoration: none;
  }

  /* theme note toast */
  #tm-note {
    position: fixed;
    left: 50%;
    bottom: 1.2rem;
    transform: translate(-50%, 20px);
    background: #052b42;
    color: #fff;
    border-radius: 8px;
    padding: 0.55rem 1rem;
    font-size: 0.66rem;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s,
      transform 0.25s;
    z-index: 60;
  }
  html.dark #tm-note {
    background: #041b2a;
    border: 1px solid #12405e;
  }
  #tm-note.on {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (min-width: 1000px) {
    .nav-links {
      display: flex;
    }
    #menu {
      display: none;
    }
    .mobile {
      display: none !important;
    }
  }
  @media (min-width: 1180px) {
    .donate-cta {
      /* hidden small screens may need it; desktop wide shows it */
    }
  }
  @media (max-width: 760px) {
    .nav {
      height: 58px;
      padding: 0 0.55rem 0 0.8rem;
      margin-left: 0.8rem;
      margin-right: 0.8rem;
    }
    .b-sub {
      display: none;
    }
    .b-name {
      font-size: 0.82rem;
    }
    .brand .mark {
      width: 30px;
      height: 30px;
      font-size: 0.78rem;
    }
    .donate-cta {
      display: none;
    }
    .icon-btn {
      width: 36px;
      height: 36px;
    }
  }
  @media (max-width: 999px) and (min-width: 761px) {
    .donate-cta {
      padding: 0.45rem 0.7rem;
      font-size: 0.74rem;
    }
  }
</style>

<script is:inline>
  (function () {
    var nav = document.getElementById('nav');
    var panel = document.getElementById('m-panel');
    if (nav && panel) {
      var place = function () {
        panel.style.top = nav.offsetTop + nav.offsetHeight + 8 + 'px';
      };
      place();
      window.addEventListener('resize', place);
      window.addEventListener('load', place);
    }
  })();
  document.querySelectorAll('.mobile a').forEach(function (a) {
    a.onclick = function () {
      document.getElementById('m-panel').hidden = true;
      document.getElementById('menu').setAttribute('aria-expanded', 'false');
    };
  });

  // Mobile menu
  var menuBtn = document.getElementById('menu');
  var panel = document.getElementById('m-panel');
  if (menuBtn && panel) {
    menuBtn.onclick = function () {
      var open = panel.hidden;
      panel.hidden = !open;
      menuBtn.setAttribute('aria-expanded', String(open));
    };
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) {
        panel.hidden = true;
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.focus();
      }
    });
    document.addEventListener('click', function (e) {
      if (panel.hidden || e.target.closest('#m-panel') || e.target.closest('#menu')) return;
      panel.hidden = true;
      menuBtn.setAttribute('aria-expanded', 'false');
    });
  }

  // Theme: cycle auto -> light -> dark
  var themeBtn = document.getElementById('theme');
  var note = document.getElementById('tm-note');
  var order = ['auto', 'light', 'dark'];
  var LABELS = { auto: 'Theme: follows your system', light: 'Theme: light', dark: 'Theme: dark' };
  if (themeBtn) {
    themeBtn.onclick = function () {
      var cur = document.documentElement.getAttribute('data-tm') || 'auto';
      var next = order[(order.indexOf(cur) + 1) % order.length];
      document.documentElement.setAttribute('data-tm', next);
      document.documentElement.classList.toggle('dark', next === 'dark' || (next === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches));
      try {
        localStorage.setItem('fcsct-theme', next);
      } catch (e) {}
      if (note) {
        note.textContent = LABELS[next];
        note.classList.add('on');
        clearTimeout(themeBtn._t);
        themeBtn._t = setTimeout(function () {
          note.classList.remove('on');
        }, 1600);
      }
    };
  }
</script>
