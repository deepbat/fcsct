---
import { url } from '../lib/urls';
import { NAV, SITE } from '../data/site';

const year = new Date().getFullYear();
const explore = NAV.filter((i) => i.href !== '/');
---

<footer>
  <div class="foot-grid">
    <div>
      <a class="foot-brand" href={url('/')}>
        <span class="mark" aria-hidden="true">FCS</span>
        <span>
          <span class="b-name">F. C. Sondhi Charitable Trust</span><br />
          <span class="b-sub">Jalandhar &middot; Since 1978</span>
        </span>
      </a>
      <p>{SITE.description}</p>
      <p style="margin-top:0.8rem">Reaching out with compassion.</p>
    </div>

    <nav aria-label="Footer">
      <h4>Explore</h4>
      <ul>
        {explore.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h4>Reach the Trust</h4>
      <address>
        <span>{SITE.address.street}<br />{SITE.address.city} {SITE.address.postalCode}<br />{SITE.address.state}, {SITE.address.country}</span>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={`https://wa.me/${SITE.whatsapp}`} rel="noopener" target="_blank">WhatsApp {SITE.phone}</a>
      </address>
    </div>
  </div>

  <div class="foot-bar">
    <span>&copy; {year} {SITE.name}</span>
    <span>All donations exempted under section <b style="color:var(--lime)">80G</b></span>
  </div>
</footer>
