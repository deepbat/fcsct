---
import { url } from '../lib/urls';
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="p-head">
  <div class="wrap">
    <p class="crumbs">
      <a href={url('/')}>Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </p>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="h-giant">{title}</h1>
    {lede && <p class="lede" style="margin-top:1.1rem">{lede}</p>}
  </div>
</section>
